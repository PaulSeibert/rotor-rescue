# Sit on the ground too long and a tank rolls up and shells the chopper: the
# first shell only damages it (everyone stays aboard, tests/damage.agk), the
# next one after its two seconds of grace destroys it: everyone aboard is
# lost, one chopper fewer, and a new (undamaged) one at the base.
start-at boarding
wait-serial "chopper damaged" 1500
expect-serial "lives=3"
wait-serial "chopper lost" 1500
wait 12
screenshot wreck
expect-serial "lives=2"
expect-serial "killed=16"
wait 160
expect-serial "state=2"
expect-serial "x=2880 y=236 face=0 landed=1"
